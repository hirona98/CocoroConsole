<UserControl x:Class="CocoroConsole.Controls.LlmSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="850"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="SettingLabelStyle"
               TargetType="TextBlock">
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Margin"
                    Value="0,0,10,0"/>
            <Setter Property="Width"
                    Value="180"/>
        </Style>
        <Style x:Key="SettingTextBoxStyle"
               TargetType="TextBox">
            <Setter Property="Padding"
                    Value="2"/>
            <Setter Property="BorderBrush"
                    Value="#CCCCCC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>
        <Style x:Key="PresetButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#4873CF"/>
            <Setter Property="Foreground"
                    Value="WhiteSmoke"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,5"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <CheckBox x:Name="IsUseLLMCheckBox"
                          Content="言語モデルを使用する"

                          Checked="IsUseLLMCheckBox_Changed"
                          Unchecked="IsUseLLMCheckBox_Changed"
                          Margin="0,5,0,0"/>

                <Grid Margin="0,10,20,0"
                      HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="PresetSelectComboBox"
                              Grid.Column="0"
                              Margin="0,5,10,5"
                              SelectionChanged="PresetSelectComboBox_SelectionChanged"
                              Width="500"/>
                    <Button Grid.Column="1"
                            Content="追加"
                            Margin="0,5,0,5"
                            Style="{StaticResource PresetButtonStyle}"
                            Click="AddPresetButton_Click"/>
                    <Button Grid.Column="2"
                            Content="複製"
                            Margin="5,5,0,5"
                            Style="{StaticResource PresetButtonStyle}"
                            Click="DuplicatePresetButton_Click"/>
                    <Button Grid.Column="3"
                            Content="削除"
                            Margin="5,5,0,5"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="DeletePresetButton_Click"/>
                </Grid>

                <Grid Margin="0,20,20,20"
                      HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="プリセット名:"
                               Style="{StaticResource SettingLabelStyle}"/>
                    <TextBox x:Name="PresetNameTextBox"
                             Grid.Column="1"
                             Width="500"
                             Style="{StaticResource SettingTextBoxStyle}"
                             TextChanged="OnSettingChanged"/>
                </Grid>

                <GroupBox Header="生成モデル設定"
                          Margin="0,0,20,20"
                          Padding="10">
                    <StackPanel>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="モデル:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="ModelTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="エンドポイントURL:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="ApiBaseTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="APIキー:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                <TextBox x:Name="ApiKeyTextBox"
                                         Width="220"
                                         Style="{StaticResource SettingTextBoxStyle}"
                                         TextChanged="OnSettingChanged"/>
                                <Button Content="コピー"
                                        Margin="10,0,0,0"
                                        Padding="10,0"
                                        Click="ApiKeyCopyButton_Click"
                                        ToolTip="クリップボードにコピー"/>
                                <Button Content="上書き貼り付け"
                                        Margin="10,0,0,0"
                                        Padding="10,0"
                                        Click="ApiKeyPasteButton_Click"
                                        ToolTip="クリップボードのテキストで上書き"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="推論の深さ:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="ReasoningEffortTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="最大出力トークン:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="MaxOutputTokensTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="タイムアウト（秒）:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="TimeoutSecondsTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                        <CheckBox x:Name="WebSearchCheckBox"
                                  Content="Web検索を使用する"
                                  Margin="0,10,0,5"

                                  Checked="OnCheckBoxChanged"
                                  Unchecked="OnCheckBoxChanged"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="直近会話の取り込み範囲（記憶は別途入ります）"
                          Margin="0,0,20,20"
                          Padding="10">
                    <StackPanel>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="件数:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="RecentTurnLimitTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="時間（分）:"
                                       Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox x:Name="RecentTurnMinutesTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource SettingTextBoxStyle}"
                                     TextChanged="OnSettingChanged"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
