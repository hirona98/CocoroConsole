<UserControl x:Class="CocoroConsole.Controls.SystemSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="SettingsGroupBoxStyle"
               TargetType="GroupBox">
            <Setter Property="BorderBrush"
                    Value="#CCCCCC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox x:Name="VoiceInputSettingsGroup"
                          Header="マイク"
                          Margin="0,0,20,20"
                          Style="{StaticResource SettingsGroupBoxStyle}">
                    <Border Background="White"
                            Padding="10">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="使用するマイク:"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="MicrophoneInputSourceComboBox"
                                          Grid.Column="1"
                                          Padding="2">
                                    <ComboBoxItem Content="OtomeKairo側のマイク"
                                                  Tag="local_microphone"/>
                                    <ComboBoxItem Content="CocoroConsole側のマイク"
                                                  Tag="console_microphone"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CocoroConsole:"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="ConsoleInputDeviceComboBox"
                                          Grid.Column="1"
                                          Padding="2"/>
                            </Grid>
                            <TextBlock x:Name="ConsoleInputDeviceStatusText"
                                       TextWrapping="Wrap"
                                       Foreground="#666666"
                                       Margin="140,0,0,0"/>
                        </StackPanel>
                    </Border>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
