<UserControl x:Class="CocoroConsole.Controls.SystemSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CocoroConsole.Controls"
             mc:Ignorable="d"
             d:DesignHeight="1300"
             d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="SettingsGroupBoxStyle"
               TargetType="GroupBox">
            <Setter Property="BorderBrush"
                    Value="#CCCCCC"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox x:Name="ConnectionSettingsGroup"
                          Header="OtomeKairo接続"
                          Margin="0,0,20,20"
                          Style="{StaticResource SettingsGroupBoxStyle}">
                    <Border Background="White"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="初回未登録の接続先では自動取得します。登録済みの接続先では発行済みのconsole_access_tokenを設定します。"
                                       TextWrapping="Wrap"
                                       Foreground="#666666"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="アクセストークン:"
                                           VerticalAlignment="Center"/>
                                <PasswordBox x:Name="OtomeKairoAccessTokenPasswordBox"
                                             Grid.Column="1"

                                             Padding="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox x:Name="ConversationSettingsGroup"
                          Header="会話入力"
                          Margin="0,0,20,20"
                          Style="{StaticResource SettingsGroupBoxStyle}">
                    <Border Background="White"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="テキスト入力と音声入力で、あなたを表す名前として使います。"
                                       TextWrapping="Wrap"
                                       Foreground="#666666"
                                       Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="あなたの名前:"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="ConversationDisplayNameTextBox"
                                         Grid.Column="1"

                                         Padding="2"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox x:Name="DesktopObservationSettingsGroup"
                          Header="デスクトップキャプチャ"
                          Margin="0,0,20,20"
                          Style="{StaticResource SettingsGroupBoxStyle}">
                    <Border Background="White"
                            Padding="10">
                        <StackPanel>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="アイドル時スキップ:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="VisualCaptureIdleTimeoutMinutesTextBox"

                                         Padding="2"
                                         Width="60"
                                         Margin="10,0,10,0"
                                         ToolTip="ユーザーがこの分数以上操作していない場合は、キャプチャ要求が来てもスキップします。0で無効。"/>
                                <TextBlock Grid.Column="2"
                                           Text="分（0で無効）"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock TextWrapping="Wrap"

                                       Margin="0,10,0,5">
                                スキップタイトルパターン（正規表現でマッチしたウィンドウタイトルはキャプチャをスキップします）
                            </TextBlock>

                            <TextBox x:Name="ExcludeWindowTitlePatternsTextBox"

                                     Padding="2"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Height="120"
                                     ToolTip="1行に1つ。正規表現。"/>
                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox x:Name="PeriodicThinkingSettingsGroup"
                          Header="定期思考"
                          Margin="0,0,20,20"
                          Style="{StaticResource SettingsGroupBoxStyle}">
                    <Border Background="White"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="OtomeKairoサーバー内部のスケジュールで発生する定期思考を設定します。外部Watcherからのwakeには適用されません。"
                                       TextWrapping="Wrap"
                                       Foreground="#666666"
                                       Margin="0,0,0,10"/>

                            <CheckBox x:Name="WakePolicyEnabledCheckBox"
                                      Content="定期思考を有効にする"
                                      Margin="0,5,0,5"
/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="定期思考間隔:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="WakeIntervalSecondsTextBox"

                                         Padding="2"
                                         Width="60"
                                         Margin="10,0,10,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="秒"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <CheckBox x:Name="WakeDesktopObservationCheckBox"
                                      Content="思考前にデスクトップを観測する"
                                      Margin="0,10,0,5"

                                      ToolTip="有効時は wake_policy.observations に vision.capture の思考前観測を保存します。"/>

                            <Grid Margin="0,8,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="発話頻度:"
                                           VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1"
                                         x:Name="ThinkingSpeechLevelTextBox"

                                         Padding="2"
                                         Width="60"
                                         Margin="10,0,10,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="1控えめ / 5標準 / 10多め"
                                           VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>
                    </Border>
                </GroupBox>

                <GroupBox x:Name="VoiceInputSettingsGroup"
                          Header="マイク・話者識別"
                          Margin="0,0,20,20"
                          Style="{StaticResource SettingsGroupBoxStyle}">
                    <Border Background="White"
                            Padding="10">
                        <StackPanel>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#666666"
                                       Margin="0,0,0,10">
                                マイクと話者識別の設定を行います。話者登録すると特定の人物の声だけを認識します。
                            </TextBlock>
                            <Grid Margin="0,5,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="入力しきい値:"
                                           VerticalAlignment="Center"/>
                                <Slider Grid.Column="1"
                                        x:Name="MicThresholdSlider"
                                        Minimum="-50"
                                        Maximum="0"
                                        Value="-45"
                                        TickFrequency="10"
                                        TickPlacement="BottomRight"
                                        Margin="10,0,10,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ElementName=MicThresholdSlider, Path=Value, StringFormat='{}{0:0} dB'}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Grid>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="#666666"
                                       Margin="0,0,0,10">
                                ※値が低いほど（-50dBに近いほど）音声を拾いやすくなりますが、環境音も拾いやすくなります。
                            </TextBlock>

                            <local:SpeakerManagementControl x:Name="SpeakerManagementControl"
                                                            Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
