<UserControl x:Class="CocoroConsole.Controls.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CocoroConsole.Controls"
             xmlns:converters="clr-namespace:CocoroConsole.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="600">

        <UserControl.Resources>
                <!-- コンバーター -->
                <converters:PercentageConverter x:Key="PercentageConverter"/>

                <!-- ボタンスタイル（無効状態対応） -->
                <Style x:Key="DisabledButtonStyle"
                       TargetType="Button">
                        <Setter Property="Background"
                                Value="#4873CF"/>
                        <Setter Property="Foreground"
                                Value="WhiteSmoke"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Template">
                                <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="5">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"
                                                                          Content="{TemplateBinding Content}"
                                                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                        <Trigger Property="IsEnabled"
                                                                 Value="False">
                                                                <Setter Property="Background"
                                                                        Value="#CCCCCC"/>
                                                                <Setter Property="Foreground"
                                                                        Value="#888888"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#5A84D9"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed"
                                                                 Value="True">
                                                                <Setter Property="Background"
                                                                        Value="#3A62B8"/>
                                                        </Trigger>
                                                </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                </Setter.Value>
                        </Setter>
                </Style>

                <!-- バブルスタイル定義 -->
                <Style x:Key="UserBubbleStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="#4873CF"/>
                        <Setter Property="CornerRadius"
                                Value="10,10,0,10"/>
                        <Setter Property="Padding"
                                Value="10"/>
                        <Setter Property="MaxWidth"
                                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PercentageConverter}, ConverterParameter=0.85}"/>
                </Style>

                <Style x:Key="AiBubbleStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="#b5c7eb"/>
                        <Setter Property="CornerRadius"
                                Value="10,10,10,0"/>
                        <Setter Property="Padding"
                                Value="10"/>
                        <Setter Property="MaxWidth"
                                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PercentageConverter}, ConverterParameter=0.85}"/>
                </Style>

                <!-- システムメッセージバブルスタイル -->
                <Style x:Key="SystemMessageBubbleStyle"
                       TargetType="Border">
                        <Setter Property="Background"
                                Value="White"/>
                        <Setter Property="BorderBrush"
                                Value="#4873CF"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="CornerRadius"
                                Value="10"/>
                        <Setter Property="Padding"
                                Value="10"/>
                        <Setter Property="Margin"
                                Value="20,5,20,5"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Center"/>
                        <Setter Property="MaxWidth"
                                Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource PercentageConverter}, ConverterParameter=0.85}"/>
                </Style>

                <!-- メッセージテキストスタイル -->
                <Style x:Key="UserDisplayNameTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="10"/>
                        <Setter Property="Foreground"
                                Value="#FF404040"/>
                        <Setter Property="Opacity"
                                Value="0.80"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Right"/>
                        <Setter Property="Margin"
                                Value="0,0,2,2"/>
                </Style>
                <Style x:Key="AiDisplayNameTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="10"/>
                        <Setter Property="Foreground"
                                Value="#FF404040"/>
                        <Setter Property="Opacity"
                                Value="0.80"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Left"/>
                        <Setter Property="Margin"
                                Value="2,0,0,2"/>
                </Style>
                <Style x:Key="UserMessageTextStyle"
                       TargetType="TextBox">
                        <Setter Property="TextWrapping"
                                Value="Wrap"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Foreground"
                                Value="WhiteSmoke"/>
                        <Setter Property="IsReadOnly"
                                Value="True"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Cursor"
                                Value="IBeam"/>
                </Style>
                <Style x:Key="AiMessageTextStyle"
                       TargetType="TextBox">
                        <Setter Property="TextWrapping"
                                Value="Wrap"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Foreground"
                                Value="#FF303030"/>
                        <Setter Property="IsReadOnly"
                                Value="True"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Cursor"
                                Value="IBeam"/>
                </Style>

                <!-- システムメッセージテキストスタイル -->
                <Style x:Key="SystemMessageTextStyle"
                       TargetType="TextBox">
                        <Setter Property="TextWrapping"
                                Value="Wrap"/>
                        <Setter Property="FontSize"
                                Value="14"/>
                        <Setter Property="Foreground"
                                Value="#4873CF"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Center"/>
                        <Setter Property="IsReadOnly"
                                Value="True"/>
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Background"
                                Value="Transparent"/>
                        <Setter Property="Cursor"
                                Value="IBeam"/>
                </Style>

                <!-- 通知メッセージテキストスタイル（テキストもセンター揃い） -->
                <Style x:Key="NotificationMessageTextStyle"
                       TargetType="TextBox"
                       BasedOn="{StaticResource SystemMessageTextStyle}">
                        <Setter Property="TextAlignment"
                                Value="Center"/>
                </Style>

                <!-- 時刻表示（LINE風：バブルの隣に小さく表示） -->
                <Style x:Key="UserTimestampTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="10"/>
                        <Setter Property="Foreground"
                                Value="#FF404040"/>
                        <Setter Property="Opacity"
                                Value="0.80"/>
                        <Setter Property="VerticalAlignment"
                                Value="Bottom"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Right"/>
                        <Setter Property="Margin"
                                Value="0,0,6,2"/>
                </Style>
                <Style x:Key="AiTimestampTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="10"/>
                        <Setter Property="Foreground"
                                Value="#FF404040"/>
                        <Setter Property="Opacity"
                                Value="0.80"/>
                        <Setter Property="VerticalAlignment"
                                Value="Bottom"/>
                        <Setter Property="HorizontalAlignment"
                                Value="Left"/>
                        <Setter Property="Margin"
                                Value="6,0,0,2"/>
                </Style>

                <DataTemplate x:Key="UserChatMessageTemplate">
                        <Grid Margin="10,5,10,5">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource UserTimestampTextStyle}"
                                           Text="{Binding TimestampText}"/>
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource UserDisplayNameTextStyle}"
                                                   Text="{Binding DisplayName}"/>
                                        <Border Style="{StaticResource UserBubbleStyle}"
                                                HorizontalAlignment="Right"
                                                MouseRightButtonUp="Bubble_MouseRightButtonUp">
                                                <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Images}">
                                                                <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <Border BorderBrush="White"
                                                                                        BorderThickness="1"
                                                                                        Margin="0,0,5,5"
                                                                                        Cursor="Hand"
                                                                                        MouseLeftButtonUp="ChatImage_MouseLeftButtonUp">
                                                                                        <Image Source="{Binding}"
                                                                                               MaxHeight="120"
                                                                                               MaxWidth="160"
                                                                                               Stretch="Uniform"/>
                                                                                </Border>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}">
                                                                <TextBox.Style>
                                                                        <Style TargetType="TextBox"
                                                                               BasedOn="{StaticResource UserMessageTextStyle}">
                                                                                <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Text}"
                                                                                                     Value="">
                                                                                                <Setter Property="Visibility"
                                                                                                        Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                </Style.Triggers>
                                                                        </Style>
                                                                </TextBox.Style>
                                                        </TextBox>
                                                </StackPanel>
                                        </Border>
                                </StackPanel>
                        </Grid>
                </DataTemplate>

                <DataTemplate x:Key="AiChatMessageTemplate">
                        <Grid Margin="10,5,10,5">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom">
                                        <TextBlock Style="{StaticResource AiDisplayNameTextStyle}"
                                                   Text="{Binding DisplayName}"/>
                                        <Border Style="{StaticResource AiBubbleStyle}"
                                                HorizontalAlignment="Left"
                                                MouseRightButtonUp="Bubble_MouseRightButtonUp">
                                                <StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Images}">
                                                                <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                        </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <Border BorderBrush="#B5C7EB"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="8"
                                                                                        Margin="0,0,0,8"
                                                                                        Cursor="Hand"
                                                                                        MouseLeftButtonUp="ChatImage_MouseLeftButtonUp">
                                                                                        <Image Source="{Binding}"
                                                                                               MaxHeight="200"
                                                                                               MaxWidth="200"
                                                                                               Stretch="Uniform"/>
                                                                                </Border>
                                                                        </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBox Text="{Binding Text, Mode=OneWay}">
                                                                <TextBox.Style>
                                                                        <Style TargetType="TextBox"
                                                                               BasedOn="{StaticResource AiMessageTextStyle}">
                                                                                <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Text}"
                                                                                                     Value="">
                                                                                                <Setter Property="Visibility"
                                                                                                        Value="Collapsed"/>
                                                                                        </DataTrigger>
                                                                                </Style.Triggers>
                                                                        </Style>
                                                                </TextBox.Style>
                                                        </TextBox>
                                                </StackPanel>
                                        </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource AiTimestampTextStyle}"
                                           Text="{Binding TimestampText}"/>
                        </Grid>
                </DataTemplate>

                <DataTemplate x:Key="SystemChatMessageTemplate">
                        <Border Style="{StaticResource SystemMessageBubbleStyle}"
                                MouseRightButtonUp="Bubble_MouseRightButtonUp">
                                <StackPanel>
                                        <TextBox Style="{StaticResource SystemMessageTextStyle}"
                                                 Text="{Binding Text, Mode=OneWay}"/>
                                        <ItemsControl ItemsSource="{Binding Images}">
                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                <Image Source="{Binding}"
                                                                       MaxHeight="200"
                                                                       MaxWidth="400"
                                                                       Stretch="Uniform"
                                                                       Cursor="Hand"
                                                                       MouseLeftButtonUp="ChatImage_MouseLeftButtonUp"/>
                                                        </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </StackPanel>
                        </Border>
                </DataTemplate>

                <DataTemplate x:Key="NotificationChatMessageTemplate">
                        <Border Style="{StaticResource SystemMessageBubbleStyle}"
                                MouseRightButtonUp="Bubble_MouseRightButtonUp">
                                <StackPanel>
                                        <TextBox Style="{StaticResource NotificationMessageTextStyle}"
                                                 Text="{Binding Text, Mode=OneWay}"/>
                                        <ItemsControl ItemsSource="{Binding Images}"
                                                      HorizontalAlignment="Center">
                                                <ItemsControl.Style>
                                                        <Style TargetType="ItemsControl">
                                                                <Setter Property="Margin"
                                                                        Value="0,10,0,0"/>
                                                                <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Images.Count}"
                                                                                     Value="0">
                                                                                <Setter Property="Visibility"
                                                                                        Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                </Style.Triggers>
                                                        </Style>
                                                </ItemsControl.Style>
                                                <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"
                                                                           HorizontalAlignment="Center"/>
                                                        </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                <Border BorderBrush="LightGray"
                                                                        BorderThickness="1"
                                                                        CornerRadius="3"
                                                                        Margin="3,0,3,0"
                                                                        Cursor="Hand"
                                                                        MouseLeftButtonUp="ChatImage_MouseLeftButtonUp">
                                                                        <Image Source="{Binding}"
                                                                               MaxHeight="120"
                                                                               MaxWidth="160"
                                                                               Stretch="Uniform"/>
                                                                </Border>
                                                        </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                </StackPanel>
                        </Border>
                </DataTemplate>

                <local:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"
                                                    UserTemplate="{StaticResource UserChatMessageTemplate}"
                                                    AiTemplate="{StaticResource AiChatMessageTemplate}"
                                                    SystemTemplate="{StaticResource SystemChatMessageTemplate}"
                                                    NotificationTemplate="{StaticResource NotificationChatMessageTemplate}"/>
        </UserControl.Resources>

        <Grid AllowDrop="True"
              Drop="Grid_Drop"
              DragEnter="Grid_DragEnter"
              DragOver="Grid_DragOver"
              DragLeave="Grid_DragLeave">
                <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- チャット表示エリア -->
                <ItemsControl x:Name="ChatMessages"
                              Grid.Row="0"
                              Margin="5"
                              Background="#FAFAFA"
                              ItemsSource="{Binding Messages, RelativeSource={RelativeSource AncestorType=local:ChatControl}}"
                              ItemTemplateSelector="{StaticResource ChatMessageTemplateSelector}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer x:Name="ChatScrollViewer"
                                                      Background="{TemplateBinding Background}"
                                                      CanContentScroll="True"
                                                      HorizontalScrollBarVisibility="Disabled"
                                                      VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                        </ScrollViewer>
                                </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                        <Setter Property="HorizontalAlignment"
                                                Value="Stretch"/>
                                </Style>
                        </ItemsControl.ItemContainerStyle>
                </ItemsControl>

                <!-- 入力エリア -->
                <Grid Grid.Row="1"
                      Margin="5">
                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 画像プレビューエリア -->
                        <Border x:Name="ImagePreviewBorder"
                                Grid.Row="0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="5"
                                Margin="0,0,0,5"
                                Height="100"
                                Background="#F0F0F0"
                                Visibility="Collapsed">
                                <Grid>
                                        <TextBlock Text="画像をドラッグ&amp;ドロップまたはクリップボードから貼り付け（最大1枚）"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#999999"
                                                   x:Name="ImagePlaceholderText"/>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      x:Name="ImagePreviewScrollViewer"
                                                      Margin="5"
                                                      Visibility="Collapsed">
                                                <WrapPanel x:Name="ImagePreviewPanel"
                                                           Orientation="Horizontal"/>
                                        </ScrollViewer>
                                </Grid>
                        </Border>

                        <!-- テキスト入力と送信ボタン -->
                        <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                        <Grid>
                                                <TextBox x:Name="MessageTextBox"
                                                         MinLines="4"
                                                         MaxLines="10"
                                                         Padding="5"
                                                         FontSize="14"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto"
                                                         PreviewKeyDown="MessageTextBox_KeyDown"
                                                         TextWrapping="Wrap"
                                                         MaxLength="10485760"
                                                         AcceptsReturn="True"
                                                         AllowDrop="True"
                                                         PreviewDragEnter="TextBox_PreviewDragEnter"
                                                         PreviewDragOver="TextBox_PreviewDragOver"
                                                         PreviewDrop="TextBox_PreviewDrop"/>
                                                <TextBlock x:Name="PlaceholderText"
                                                           Text="テキストと画像の入力が可能です"
                                                           FontSize="14"
                                                           Foreground="#999999"
                                                           Margin="5,5,0,0"
                                                           IsHitTestVisible="False">
                                                        <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility"
                                                                                Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Text, ElementName=MessageTextBox}"
                                                                                             Value="">
                                                                                        <Setter Property="Visibility"
                                                                                                Value="Visible"/>
                                                                                </DataTrigger>
                                                                        </Style.Triggers>
                                                                </Style>
                                                        </TextBlock.Style>
                                                </TextBlock>
                                        </Grid>
                                </Border>

                                <!-- 実効入力元のマイク音量を下から上へ表示する -->
                                <Border x:Name="VoiceLevelBorder"
                                        Grid.Column="1"
                                        Width="10"
                                        Margin="5,0,5,0"
                                        Background="#E0E0E0"
                                        CornerRadius="5"
                                        SizeChanged="VoiceLevelBorder_SizeChanged"
                                        ToolTip="マイク入力レベル">
                                        <Rectangle x:Name="VoiceLevelBar"
                                                   Height="0"
                                                   Fill="#9E9E9E"
                                                   RadiusX="5"
                                                   RadiusY="5"
                                                   VerticalAlignment="Bottom"/>
                                </Border>

                                <Button x:Name="SendButton"
                                        Grid.Column="2"
                                        Content="送信"
                                        Width="60"
                                        Click="SendButton_Click"
                                        FontSize="14"
                                        Style="{StaticResource DisabledButtonStyle}"/>
                        </Grid>
                </Grid>
        </Grid>
</UserControl>
