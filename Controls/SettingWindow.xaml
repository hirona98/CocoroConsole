<Window x:Class="CocoroConsole.Controls.SettingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CocoroConsole.Controls"
        xmlns:converters="clr-namespace:CocoroConsole.Converters"
        mc:Ignorable="d"
        Title="設定"
        Height="900"
        Width="1120"
        MinHeight="700"
        MinWidth="1000"
        FontSize="14"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="NavigationCategoryStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="#222222"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Margin"
                    Value="14,20,14,6"/>
        </Style>

        <Style x:Key="NavigationItemStyle"
               TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="#444444"/>
            <Setter Property="Background"
                    Value="Transparent"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Padding"
                    Value="18,8"/>
            <Setter Property="Margin"
                    Value="6,1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#EAF0FC"/>
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="NavigationBorder"
                                        Property="Background"
                                        Value="#DDE8FA"/>
                                <Setter Property="Foreground"
                                        Value="#285FB7"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DisabledButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#4873CF"/>
            <Setter Property="Foreground"
                    Value="WhiteSmoke"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Background"
                                        Value="#CCCCCC"/>
                                <Setter Property="Foreground"
                                        Value="#888888"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#5A84D9"/>
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter Property="Background"
                                        Value="#3A62B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <converters:PercentageConverter x:Key="PercentageConverter"/>
        <converters:AnimationTypeConverter x:Key="AnimationTypeConverter"/>
    </Window.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E1E4E8"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,8,0,14">
                        <TextBlock Text="個"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton Content="人格設定"
                                     Tag="persona"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="モデル"
                                     Tag="model"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="記憶"
                                     Tag="memory"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>

                        <TextBlock Text="表現"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton x:Name="DisplayNavigationButton"
                                     Content="表示"
                                     Tag="display"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"
                                     IsChecked="True"/>
                        <RadioButton Content="アバター"
                                     Tag="avatar"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="モーション"
                                     Tag="motion"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>

                        <TextBlock Text="入力"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton Content="会話入力"
                                     Tag="conversation"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>

                        <TextBlock Text="自律動作"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton Content="定期思考"
                                     Tag="periodic-thinking"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>

                        <TextBlock Text="観測と監視"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton Content="デスクトップ"
                                     Tag="desktop"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="カメラ"
                                     Tag="camera"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="Watcher"
                                     Tag="watcher"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>

                        <TextBlock Text="外部連携"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton Content="OtomeKairo接続"
                                     Tag="connection"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="ツール（MCP）"
                                     Tag="mcp"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                        <RadioButton Content="API説明"
                                     Tag="api"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>

                        <TextBlock Text="情報"
                                   Style="{StaticResource NavigationCategoryStyle}"/>
                        <RadioButton Content="ライセンス"
                                     Tag="license"
                                     GroupName="SettingsNavigation"
                                     Style="{StaticResource NavigationItemStyle}"
                                     Checked="NavigationButton_Checked"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        BorderBrush="#E8E8E8"
                        BorderThickness="0,0,0,1"
                        Padding="24,18,24,14">
                    <StackPanel>
                        <TextBlock x:Name="PageTitleTextBlock"
                                   Text="表示"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#222222"/>
                        <TextBlock x:Name="PageDescriptionTextBlock"
                                   Text="CocoroConsoleの表示方法を設定します。"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Grid x:Name="SettingsContentHost"
                      Grid.Row="1"
                      Margin="20,18,0,20">
                    <local:DisplaySettingsControl x:Name="DisplaySettingsControl"/>
                    <local:AvatarManagementControl x:Name="AvatarManagementControl"
                                                   Visibility="Collapsed"/>
                    <local:PromptSettingsControl x:Name="PromptSettingsControl"
                                                 Visibility="Collapsed"/>
                    <local:LlmSettingsControl x:Name="LlmSettingsControl"
                                              Visibility="Collapsed"/>
                    <local:EmbeddingSettingsControl x:Name="EmbeddingSettingsControl"
                                                    Visibility="Collapsed"/>
                    <local:AnimationSettingsControl x:Name="AnimationSettingsControl"
                                                    Visibility="Collapsed"/>
                    <local:SystemSettingsControl x:Name="SystemSettingsControl"
                                                 Visibility="Collapsed"/>
                    <local:CapabilitySettingsControl x:Name="CapabilitySettingsControl"
                                                     Visibility="Collapsed"/>
                    <local:ApiDocumentationControl x:Name="ApiDocumentationControl"
                                                   Visibility="Collapsed"/>

                    <Grid x:Name="LicensePage"
                          Visibility="Collapsed"
                          Margin="0,0,20,0">
                        <Border BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="5">
                            <TextBox x:Name="LicenseTextBox"

                                     Padding="8"
                                     BorderThickness="0"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     IsReadOnly="True"/>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="1"
                Background="#F5F5F5"
                Padding="15"
                BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="LogViewerButton"
                        Grid.Column="0"
                        Content="ログ表示"
                        Width="100"
                        Height="30"
                        Click="LogViewerButton_Click"
                        ToolTip="デバッグログウィンドウを開きます"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Width="80"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource DisabledButtonStyle}"
                            Click="OkButton_Click"/>
                    <Button x:Name="CancelButton"
                            Content="キャンセル"
                            Width="80"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource DisabledButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button x:Name="ApplyButton"
                            Content="適用"
                            Width="80"
                            Height="30"
                            Style="{StaticResource DisabledButtonStyle}"
                            Click="ApplyButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
