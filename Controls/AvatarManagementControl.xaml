<UserControl x:Class="CocoroConsole.Controls.AvatarManagementControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- アバター選択 -->
                <Grid Margin="0,0,20,0"
                      ToolTip="Select avatar (restart required)">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="85"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="AvatarSelectComboBox"
                              Grid.Column="0"
                              Margin="0,5,10,5"
                              SelectionChanged="AvatarSelectComboBox_SelectionChanged"
                              DisplayMemberPath="modelName"
                              SelectedValuePath="modelName"/>

                    <Button x:Name="AddAvatarButton"
                            Grid.Column="1"
                            Content="追加"
                            Margin="0,5,0,5"
                            Padding="10,5"
                            Click="AddAvatarButton_Click"
                            ToolTip="Add avatar"/>

                    <Button x:Name="DuplicateAvatarButton"
                            Grid.Column="2"
                            Content="複製"
                            Margin="5,5,0,5"
                            Padding="10,5"
                            Click="DuplicateAvatarButton_Click"
                            ToolTip="Duplicate current avatar"/>

                    <Button x:Name="DeleteAvatarButton"
                            Grid.Column="3"
                            Content="削除"
                            Margin="5,5,0,5"
                            Padding="10,5"
                            Style="{StaticResource DeleteButtonStyle}"
                            Click="DeleteAvatarButton_Click"
                            ToolTip="Delete this avatar"/>
                </Grid>

                <Grid Margin="0,20,20,0"
                      ToolTip="Basic setting">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="プリセット名:"
                               VerticalAlignment="Center"
                               ToolTip="Name"/>
                    <TextBox Grid.Column="1"
                             x:Name="AvatarNameTextBox"
                             Padding="2"
                             TextChanged="AvatarNameTextBox_TextChanged"
                             Width="500"
                             HorizontalAlignment="Left"/>
                </Grid>

                <!-- VRM設定 -->
                <GroupBox Header="VRM"
                          Margin="0,20,20,20"
                          Padding="10">
                    <StackPanel>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="VRMファイル:"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1"
                                     x:Name="VRMFilePathTextBox"
                                     Padding="2"
                                     IsReadOnly="False"
                                     TextChanged="OnAvatarPresentationChanged"/>
                            <Button Grid.Column="2"
                                    x:Name="BrowseVrmFileButton"
                                    Content="開く..."
                                    Padding="10,0"
                                    Click="BrowseVrmFileButton_Click"
                                    ToolTip="Open..."
                                    Margin="5,0,0,0"/>
                        </Grid>

                        <CheckBox x:Name="ConvertMToonCheckBox"
                                  Content="UnlitをMToonに変換する（正常に表示されないときに有効にしてみてください）"
                                  Margin="0,10,0,0"
                                  Checked="OnAvatarPresentationChanged"
                                  Unchecked="OnAvatarPresentationChanged"/>

                        <CheckBox x:Name="EnableShadowOffCheckBox"
                                  Content="指定したメッシュに影を落とさない（顔などを想定）"
                                  Checked="EnableShadowOffCheckBox_Checked"
                                  Unchecked="EnableShadowOffCheckBox_Unchecked"
                                  Margin="0,10,0,0"/>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="メッシュ名:"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>
                            <TextBox Grid.Column="1"
                                     x:Name="ShadowOffMeshTextBox"
                                     Padding="2"
                                     ToolTip="カンマ区切りでメッシュ名を入力 (例: Face, U_Char_1)"
                                     TextChanged="OnAvatarPresentationChanged"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
